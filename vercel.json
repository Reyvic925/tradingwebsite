{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    {
      "source": "/((?!api/|videos/|images/|logos/|downloads/|favicon.svg|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/simulate", "schedule": "* * * * *" },
    { "path": "/api/cron/tick", "schedule": "*/5 * * * *" }
  ]
}
