{
  "name": "apex-prime",
  "private": true,
  "version": "1.0.0",
  "description": "Apex Prime Broker — full-stack multi-asset trading platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reyvic925/tradingwebsite.git"
  },
  "bugs": {
    "url": "https://github.com/Reyvic925/tradingwebsite/issues"
  },
  "homepage": "https://github.com/Reyvic925/tradingwebsite#readme",
  "type": "module",
  "keywords": [
    "trading",
    "broker",
    "finance",
    "crypto",
    "multi-asset"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "lint": "eslint .",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply apex-prime-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply apex-prime-db --remote",
    "audit": "npm run audit:copiers",
    "preview": "vite preview",
    "pack": "node scripts/pack-source.mjs",
    "test": "node tests/unit/worker-auth.test.mjs && node tests/unit/worker-email.test.mjs && node tests/unit/login-page-mode.test.mjs && node tests/unit/worker-deposit-api.test.mjs && node tests/unit/referral-api.test.mjs && node tests/unit/kyc-api.test.mjs && node tests/unit/withdrawal-api.test.mjs && node tests/unit/roi-withdrawal-api.test.mjs && node tests/unit/vercel-preview-proxy.test.mjs && node tests/unit/public-api.test.mjs && node tests/unit/worker-market-quotes.test.mjs && node tests/unit/paper-trading.test.mjs && node tests/unit/crypto-keys.test.mjs && node tests/unit/d1-crypto-wallets.test.mjs && node tests/unit/d1-wallet-provisioning.test.mjs && node tests/unit/check-charts.test.mjs && node tests/unit/admin-users.test.mjs && node tests/unit/investment-tick.test.mjs && node tests/unit/d1-traders-api.test.mjs && node tests/unit/trader-validation.test.mjs && node tests/unit/synthetic-simulation.test.mjs && node tests/unit/synthetic-metrics.test.mjs && node tests/unit/roi-simulator.test.mjs && node tests/unit/copy-trading-tick.test.mjs",
    "test:auth": "node tests/unit/worker-auth.test.mjs",
    "test:public-api": "node tests/unit/public-api.test.mjs",
    "migrate:public:export": "node scripts/migrate-public-read-data.mjs --export tmp/apex-prime-public-data.json",
    "backfill:wallets": "node scripts/backfill-wallets.js",
    "seed:kyc": "node scripts/seed-kyc-table.js",
    "seed:public:data": "node scripts/seed-public-data.mjs",
    "audit:traders": "node scripts/audit-traders-reconcile.mjs",
    "traders:migrate": "node scripts/migrate-traders-to-simulation.mjs",
    "traders:rebuild-metrics": "node scripts/rebuild-trader-metrics.mjs",
    "traders:24h-test": "node scripts/test-trader-simulation-24h.mjs",
    "traders:migration-report": "node scripts/report-trader-migration.mjs",
    "traders:backfill-profiles": "node scripts/backfill-trader-profiles.mjs",
    "traders:reconcile-status": "node scripts/reconcile-trader-status.mjs",
    "traders:backfill-history": "node scripts/backfill-trader-history.mjs",
    "traders:bootstrap-history": "node scripts/bootstrap-trader-history.mjs",
    "audit:copiers": "node scripts/reconcile-trader-copiers.mjs",
    "seed:copiers": "node scripts/reconcile-trader-copiers.mjs --seed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "bip32": "2.0.6",
    "bip39": "^3.0.4",
    "bitcoinjs-lib": "^5.2.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.12.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.2.1",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@supabase/supabase-js": "^2.99.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "^4.136.2"
  }
}
