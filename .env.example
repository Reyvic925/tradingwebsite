# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# In Supabase Dashboard -> Authentication -> Providers -> Email, enable
# "Confirm email". Set the Auth Site URL and redirect allow-list to APP_URL
# (and your local development URL) so confirmation links can return to /login.

# Transactional email (server only)
RESEND_API_KEY=re_xxxxxxxxx
# Must be a Resend-verified sender, e.g. no-reply@yourdomain.com
RESEND_FROM_EMAIL="Apex Prime <no-reply@yourdomain.com>"
# Public site URL, used in email links
APP_URL=https://yourdomain.com

# Google OAuth (optional — email/password works without these)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
