# Supabase
VITE_SUPABASE_URL=https://xslfgntbpnzvhaxfegap.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# In Supabase Dashboard -> Authentication -> Providers -> Email, enable
# "Confirm email". Set the Auth Site URL and Redirect URLs allow-list to APP_URL/login
# (and, for local development, http://localhost:3000/login). The redirect URL must
# match exactly or Supabase falls back to the Site URL (often http://localhost:3000/).

# Transactional email (server only)
RESEND_API_KEY=re_xxxxxxxxx
# Must be a Resend-verified sender, e.g. no-reply@yourdomain.com
RESEND_FROM_EMAIL="Apex Prime <no-reply@yourdomain.com>"
# Public site URL, used in email links
APP_URL=https://yourdomain.com

# Google OAuth (optional — email/password works without these)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Optional Cloudflare Worker authentication staging mode.
# Leave unset for the existing Supabase authentication path.
VITE_AUTH_PROVIDER=supabase
# Leave empty to use the same origin; set this only for a separate staging Worker.
VITE_WORKER_AUTH_URL=
