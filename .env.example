# Base URL for the Cloudflare Worker that serves the D1-backed API.
# For local development, run `npm run cf:dev` in another terminal.
WORKER_API_URL=http://127.0.0.1:8787

# Transactional email (server only)
RESEND_API_KEY=re_xxxxxxxxx
# Must be a Resend-verified sender, e.g. no-reply@yourdomain.com
RESEND_FROM_EMAIL="Apex Prime <no-reply@yourdomain.com>"
# Public site URL, used in email links
APP_URL=https://yourdomain.com

# Google OAuth (optional — email/password works without these)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Leave empty to use the same origin; set only when the browser should use a
# separate staging Worker directly instead of the same-origin API proxy.
VITE_WORKER_AUTH_URL=
