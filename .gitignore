nosetests.xml
coverage.xml
*.cover
*.log
.DS_Store
Thumbs.db

# Compiled and binary files
*.class
*.o
*.so
*.dll
*.exe
*.out
*.obj
*.a
*.lib

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Testing
.coverage
htmlcov/
.nyc_output
coverage/
.pytest_cache/
.mypy_cache/

# Compression and archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
